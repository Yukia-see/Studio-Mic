[Unit]
Description=Studio Mic audio engine (PipeWire buses, mic processing, mixer)
After=pipewire.service wireplumber.service pipewire-pulse.service
Requires=pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/studiomic --daemon
# SIGTERM makes Studio Mic flush state.json and stop its child processes cleanly.
KillSignal=SIGTERM
TimeoutStopSec=8
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
